SEQ
  FUNCTION
    IDENT factorial
    PARAMS
      PARAM
        IDENT n
        TYPE int
    TYPE int
    SEQ
      IF
        BINOP <=
          IDENT n
          INT 1
        SEQ
          RETURN
            INT 1
        ELSE
          SEQ
            RETURN
              BINOP *
                IDENT n
                CALL
                  IDENT factorial
                  ARGS
                    BINOP -
                      IDENT n
                      INT 1
  FUNCTION
    IDENT is_even
    PARAMS
      PARAM
        IDENT x
        TYPE int
    TYPE bool
    SEQ
      RETURN
        BINOP ==
          BINOP %
            IDENT x
            INT 2
          INT 0
  FUNCTION
    IDENT main
        TYPE int
    SEQ
      DECL
        IDENT i
        VARIABLE
        TYPE int
        INT 0
      DECL
        IDENT result
        VARIABLE
        TYPE int
      DECL
        IDENT limit
        CONSTANT
        TYPE int
        INT 10
      WHILE
        BINOP <
          IDENT i
          IDENT limit
        SEQ
          ASSIGN
            IDENT i
            BINOP +
              IDENT i
              INT 1
      FOR
        DECL
          IDENT j
          VARIABLE
          TYPE int
          INT 0
        BINOP <
          IDENT j
          IDENT limit
        BINOP +
          IDENT j
          INT 1
        SEQ
          IF
            BINOP ==
              BINOP %
                IDENT j
                INT 5
              INT 0
            SEQ
              IF
                BINOP ==
                  BINOP %
                    IDENT j
                    INT 3
                  INT 0
                SEQ
                  CALL
                    IDENT printf
                    ARGS
                      STRING "FizzBuzz\n";"
                ELSE
                  SEQ
                    CALL
                      IDENT printf
                      ARGS
                        STRING "Buzz\n";"
            IF
              BINOP ==
                BINOP %
                  IDENT j
                  INT 3
                INT 0
              SEQ
                CALL
                  IDENT printf
                  ARGS
                    STRING "Fizz\n";"
              ELSE
                SEQ
                  CALL
                    IDENT printf
                    ARGS
                      STRING "%d\n","
                      IDENT j
      ASSIGN
        IDENT result
        CALL
          IDENT factorial
          ARGS
            INT 5
      IF
        CALL
          IDENT is_even
          ARGS
            BINOP ||
              BINOP &&
                IDENT result
                TRUE
              FALSE
        SEQ
          CALL
            IDENT printf
            ARGS
              STRING "Result is even: %d\n","
              IDENT result
        ELSE
          SEQ
            CALL
              IDENT printf
              ARGS
                STRING "Result is odd: %d\n","
                IDENT result
      CALL
        IDENT printf
        ARGS
          STRING "int=%d dec=%f char=%c str=%s bool=%d nope=%d\n","
          INT 42
          DECIMAL 3.140000
          CHAR 'A'
          STRING "hello","
          TRUE
          NOPE
      RETURN
        INT 0


